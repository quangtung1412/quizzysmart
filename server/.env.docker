# ============================================
# Docker Environment Configuration Template
# ============================================
# Copy this file to .env and update with your values
# Keep .env secret and DO NOT commit to git

# ============================================
# Database (MySQL)
# ============================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
DATABASE_URL=mysql://quizzysmart:quizzysmart123@mysql:3306/quizzysmart?charset=utf8mb4

# Server Port
PORT=3000

# Node Environment
NODE_ENV=production

# ==============================================
# Domain - Chỉ cần thay đổi ở đây khi đổi domain
# ==============================================
APP_DOMAIN=your-domain.com

# Production credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Base URLs - Tự động derive từ APP_DOMAIN trong code.
# Chỉ override nếu cần (vd: Docker internal routing)
BACKEND_BASE_URL=http://backend:3000
# APP_BASE_URL= (auto: https://$APP_DOMAIN)
# GOOGLE_CALLBACK_URL= (auto: https://$APP_DOMAIN/api/auth/google/callback)
# ALLOWED_ORIGINS= (auto: includes https://$APP_DOMAIN + localhost)

# Security Keys - CHANGE THESE!
SESSION_SECRET=generate-a-random-secret-key-here
JWT_SECRET=generate-another-random-secret-key-here

MAX_BODY_SIZE=15mb

# Google Gemini AI API Keys
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_IMPORT=your-gemini-import-key-here

# Telegram Bot Configuration (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# PayOS Configuration (Optional)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# ============================================
# Qdrant Vector Database (Local)
# ============================================
# Uses Qdrant localhost container instead of cloud
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=vietnamese_documents
